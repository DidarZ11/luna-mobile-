# Скопируй в .env и заполни. .env в git не попадает.
ANTHROPIC_API_KEY=sk-ant-...

# Токен, который приложение шлёт в заголовке Authorization (вписать его же в настройках приложения).
# Пусто — без проверки (только для локальной разработки).
APP_TOKEN=

# Голос: edge (бесплатно, Vivienne) | elevenlabs | off (системный голос телефона)
LUNA_TTS=edge
# ElevenLabs: ключ + id голоса (npm run library — готовые голоса, npm run design — свой по описанию)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL=eleven_flash_v2_5

# Необязательно
# PORT=3000
# LUNA_MODEL=claude-opus-5-5
